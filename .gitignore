# --- OS / 编辑器 ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.iml

# --- 日志 / 临时 ---
*.log
*.tmp
.tmp/

# --- 本地对象存储 Silo（MinIO 分支）二进制与数据（运行时产物，不入库）---
/.silo/
/silo/
silo-data/
silodata/

# --- 本地媒体链路联调用极简 S3 stub（非生产，不入库）---
/.s3tmp/

# --- Redis 本地落盘快照（运行时产物，不入库）---
*.rdb
server/dump.rdb

# --- Android 构建产物（APK/AAB 不入库）---
*.apk
*.aab
*.ap_
*.dex
*.class

# --- Go 编译产物 ---
/server/bin/
/server/build/
/server/tmp/
*.exe
*.exe~

# 说明：Flutter 客户端由 app/.gitignore 负责（build/、.dart_tool/、local.properties 等）
# 但 app/.gitignore 未覆盖 android 顶层 build 目录，这里补上：
app/android/build/
app/android/app/build/
.gradle/
.flutter-plugins*
.pub-cache/
.pub/
