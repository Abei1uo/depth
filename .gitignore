# --- OS / 编辑器 ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.iml

# --- 日志 / 临时 ---
*.log
*.tmp
.tmp/

# --- Android 构建产物（APK/AAB 不入库）---
*.apk
*.aab
*.ap_
*.dex
*.class

# --- Go 编译产物 ---
/server/bin/
/server/build/
/server/tmp/
*.exe
*.exe~

# 说明：Flutter 客户端由 app/.gitignore 负责（build/、.dart_tool/、local.properties 等）
# 但 app/.gitignore 未覆盖 android 顶层 build 目录，这里补上：
app/android/build/
app/android/app/build/
.gradle/
.flutter-plugins*
.pub-cache/
.pub/
